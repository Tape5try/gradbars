% Example third-party library using only documented gradbars interfaces.
\ProvidesPackage{gradbars-contrib-demo}[2026/10/30 v1.0.0 Public extension example]
\gradbarsdeclaretype{demo-score}{\gradbar[color=teal,rounded=1pt]{#1}}
\gradbarsdeclareformatter{demo-boxed}{\fbox{\gradbarsformatnumber[precision=#2,number format=#3]{#1}}}
\gradtablestyle{demo-report}{style=academic,theme=teal,header align=c}
\endinput
