\cs_new_protected:Npn\__gradbars_legend_scale_name:
  {\int_gincr:N\g__gradbars_legend_scale_int
   \tl_set:Nx\l__gradbars_legend_scale_name_tl{gradbars-internal-legend-\int_use:N\g__gradbars_legend_scale_int}
   \prop_if_in:NVTF\l__gradbars_scale_groups_prop\l__gradbars_legend_scale_name_tl
     {\__gradbars_legend_scale_name:}{}}

