\pgfkeys{/gradbars,
 compare~panel~ratio/.store~in=\gradbars@panelratio,
 compare~panel~gap/.store~in=\gradbars@panelgap,
 card~panel~ratio/.store~in=\gradbars@panelratio,card~panel~gap/.store~in=\gradbars@panelgap}
\NewDocumentCommand\gradsparkband{O{} m m m}
 {\group_begin:\bool_set_true:N\l__gradbars_spark_band_bool
  \tl_set:Nn\l__gradbars_spark_band_low_tl{#3}
  \tl_set:Nn\l__gradbars_spark_band_high_tl{#4}
  \gradspark[#1]{#2}\group_end:}
\NewDocumentCommand\gradsparkcompare{O{} m}
 {\group_begin:\bool_set_true:N\l__gradbars_spark_compare_bool
