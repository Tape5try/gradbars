\cs_new_protected:Npn\gradbarsDrawSparkBars
  {\int_zero:N\l__gradbars_series_index_int
   \pgfmathsetlengthmacro\gradbars@sparkhalf
     {\gradbars@sparkbarwidth/(2*\seq_count:N\l__gradbars_series_seq)*\gradbars@width}
   \pgfmathsetlengthmacro\gradbars@sparkbase
     {\fp_eval:n{max(0,min(1,-\l__gradbars_series_low_fp/
       (\l__gradbars_series_high_fp-\l__gradbars_series_low_fp)))}*\gradbars@height}
   \draw[draw=\gradbars@sparkzerocolor,line~width=.3pt]
     (0,\gradbars@sparkbase)--(\gradbars@width,\gradbars@sparkbase);
   \seq_map_inline:Nn\l__gradbars_series_seq
     {\int_incr:N\l__gradbars_series_index_int
      \str_if_eq:nnF{##1}{NA}
        {\pgfmathsetlengthmacro\gradbars@sparkx
           {(\l__gradbars_series_index_int-.5)/\seq_count:N\l__gradbars_series_seq*\gradbars@width}
         \str_if_eq:eeTF{\gradbars@sparktype}{winloss}
           {\pgfmathsetlengthmacro\gradbars@sparky{\fp_eval:n{(sign(##1)+1)/2}*\gradbars@height}
            \let\gradbars@sparkfill\gradbars@sparkwincolor
            \fp_compare:nNnT{##1}<{0}{\let\gradbars@sparkfill\gradbars@sparklosscolor}}
           {\pgfmathsetlengthmacro\gradbars@sparky
              {\fp_eval:n{max(0,min(1,(##1-\l__gradbars_series_low_fp)/
                (\l__gradbars_series_high_fp-\l__gradbars_series_low_fp)))}*\gradbars@height}
            \let\gradbars@sparkfill\gradbars@left
            \fp_compare:nNnT{##1}<{0}{\let\gradbars@sparkfill\gradbars@negativecolor}}
         \ifgradbars@print\def\gradbars@sparkfill{black!65}
           \fp_compare:nNnT{##1}<{0}{\def\gradbars@sparkfill{black!35}}\fi
         \dim_compare:nNnTF{\gradbars@sparky}={\gradbars@sparkbase}
           {\draw[draw=\gradbars@sparkzerocolor,line~width=.8pt]
              ([xshift=-\gradbars@sparkhalf]\gradbars@sparkx,\gradbars@sparkbase)--
              ([xshift=\gradbars@sparkhalf]\gradbars@sparkx,\gradbars@sparkbase);}
           {\path[fill=\gradbars@sparkfill,draw=none]
              ([xshift=-\gradbars@sparkhalf]\gradbars@sparkx,\gradbars@sparkbase) rectangle
              ([xshift=\gradbars@sparkhalf]\gradbars@sparkx,\gradbars@sparky);}}}}

