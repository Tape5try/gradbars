 {\__gradbars_alt_before_compositions:
  \bool_if:NT\l__gradbars_spark_band_bool
   {\tl_put_right:Nx\l__gradbars_alt_tl
     {~Fixed~reference~band~(not~observations~or~a~confidence~interval):~
