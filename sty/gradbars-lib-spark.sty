    \seq_map_inline:Nn \l__gradbars_series_seq
      {\int_incr:N \l__gradbars_series_index_int
       \str_if_eq:nnTF {##1}{NA}
         {\bool_set_false:N \l__gradbars_series_prev_bool}
         {\pgfmathsetlengthmacro\gradbars@sparkx
            {\fp_eval:n {\seq_count:N \l__gradbars_series_seq=1 ? .5 :
              (\l__gradbars_series_index_int-1)/max(1,\seq_count:N \l__gradbars_series_seq-1)}*\gradbars@width}
          \fp_compare:nNnTF {\l__gradbars_series_low_fp} = {\l__gradbars_series_high_fp}
            {\pgfmathsetlengthmacro\gradbars@sparky{.5*\gradbars@height}}
            {\pgfmathsetlengthmacro\gradbars@sparky
              {\fp_eval:n {max(0,min(1,(##1-\l__gradbars_series_low_fp)/
                (\l__gradbars_series_high_fp-\l__gradbars_series_low_fp)))}*\gradbars@height}}
          \bool_if:NT \l__gradbars_series_prev_bool
            {\draw[draw=\gradbars@left,line~width=\gradbars@stemwidth]
              (\gradbars@sparkprevx,\gradbars@sparkprevy)--(\gradbars@sparkx,\gradbars@sparky);}
          \bool_set_false:N \l__gradbars_series_mark_bool
          \let\gradbars@pointcolor\gradbars@left
          \str_case_e:nn {\gradbars@sparkpoints}
            {{all}{\bool_set_true:N \l__gradbars_series_mark_bool}
             {extrema}{\fp_compare:nNnT {##1} = {\l__gradbars_series_min_fp}
                {\bool_set_true:N \l__gradbars_series_mark_bool\let\gradbars@pointcolor\gradbars@sparklow}
               \fp_compare:nNnT {##1} = {\l__gradbars_series_max_fp}
                {\bool_set_true:N \l__gradbars_series_mark_bool\let\gradbars@pointcolor\gradbars@sparkhigh}}}
          \str_if_eq:eeF {\gradbars@sparkpoints}{none}
            {\int_compare:nNnT {\l__gradbars_series_index_int} = {\seq_count:N \l__gradbars_series_seq}
               {\bool_set_true:N \l__gradbars_series_mark_bool}}
          \bool_if:NT \l__gradbars_series_mark_bool
            {\gradbarsDrawMarker{\gradbars@sparkx}{\gradbars@sparky}
               {\gradbars@pointcolor}{\gradbars@markerfill}}
          \let\gradbars@sparkprevx\gradbars@sparkx\let\gradbars@sparkprevy\gradbars@sparky
          \bool_set_true:N \l__gradbars_series_prev_bool}}
  }

