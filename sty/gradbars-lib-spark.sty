        {\gradbarsFail{Spark~target~requires~spark~range=fixed~or~a~named~scale}}
      \str_if_eq:eeF{\gradbars@sparktype}{line}
        {\gradbarsFail{Spark~target~requires~spark~type=line}}
      \gradbarsCheckNumber{\l__gradbars_spark_target_tl}{spark~target}
