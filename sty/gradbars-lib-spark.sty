        {\fp_eval:n{(\l__gradbars_spark_target_tl-\l__gradbars_series_low_fp)/
          (\l__gradbars_series_high_fp-\l__gradbars_series_low_fp)}*\gradbars@height}
      \draw[dashed,draw=\gradbars@targetcolor,line~width=.6pt]
        (0,\gradbars@sparktargety)--(\gradbars@width,\gradbars@sparktargety);}
   \__gradbars_spark_draw_before_target:}
\cs_new_eq:NN\__gradbars_spark_alt_before_target:\gradbarsBuildAlt
