\ExplSyntaxOff
\ExplSyntaxOn
\fp_new:N\l__gradbars_heat_value_fp
\cs_new_protected:Npn\gradbarsHeatColor #1
  {\colorlet{gradbarsHeatLow}{\gradbars@heatlow}
   \colorlet{gradbarsHeatHigh}{\gradbars@heathigh}
   \colorlet{gradbarsHeatCenter}{\gradbars@heatcentercolor}
   \ifgradbars@print
     \colorlet{gradbarsHeatLow}{white}\colorlet{gradbarsHeatHigh}{black!75}
     \str_if_eq:eeT{\gradbars@heatpalette}{diverging}
       {\colorlet{gradbarsHeatLow}{black!75}\colorlet{gradbarsHeatCenter}{white}}
   \fi
   \str_if_eq:eeTF{\gradbars@heatpalette}{diverging}
     {\str_if_eq:eeT{\gradbars@better}{lower}
        {\colorlet{gradbarsHeatSwap}{gradbarsHeatLow}
         \colorlet{gradbarsHeatLow}{gradbarsHeatHigh}\colorlet{gradbarsHeatHigh}{gradbarsHeatSwap}}
      \fp_set:Nn\l__gradbars_heat_value_fp{max(\gradbars@min,min(\gradbars@max,#1))}
      \fp_compare:nNnTF{\l__gradbars_heat_value_fp}={\gradbars@heatcenter}
        {\colorlet{gradbarsHeatCell}{gradbarsHeatCenter}}
        {\fp_compare:nNnTF{\l__gradbars_heat_value_fp}<{\gradbars@heatcenter}
           {\colorlet{gradbarsHeatCell}{gradbarsHeatLow!\fp_eval:n{
             100*(\gradbars@heatcenter-\l__gradbars_heat_value_fp)/(\gradbars@heatcenter-\gradbars@min)}!gradbarsHeatCenter}}
           {\colorlet{gradbarsHeatCell}{gradbarsHeatHigh!\fp_eval:n{
             100*(\l__gradbars_heat_value_fp-\gradbars@heatcenter)/(\gradbars@max-\gradbars@heatcenter)}!gradbarsHeatCenter}}}}
     {\colorlet{gradbarsHeatCell}{gradbarsHeatHigh!\fp_eval:n{
        100*\str_if_eq:eeTF{\gradbars@better}{lower}{(1-\gradbarsPosition{#1})}{\gradbarsPosition{#1}}}!gradbarsHeatLow}}}

