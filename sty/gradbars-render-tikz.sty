\cs_new_protected:Npn \__gradbars_render_tikz: {
    \ifpgfpicture
      \begin{scope}\gradbars@draw\end{scope}%
    \else
      \gradbarsPrepareAlt
      \tikz[baseline=(gradbarsbaseline)]{\gradbars@draw}%
    \fi
}

