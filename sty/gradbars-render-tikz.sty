          (\gradbars@xstart,0) rectangle (\gradbars@xstop,\gradbars@height);
      \fi\fi\fi
      \ifgradbars@stack\else\ifgradbars@outline\else
        \clip[rounded corners=\gradbars@fillradius]
          (\gradbars@xstart,0) rectangle (\gradbars@xstop,\gradbars@height);
        \gradbarsPatternRect{0}{\gradbars@xstart}{0}{\gradbars@xstop}{\gradbars@height}
      \fi
      \fi
