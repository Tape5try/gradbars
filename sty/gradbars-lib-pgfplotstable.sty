\ProvidesPackage{gradbars-lib-pgfplotstable}[2026/11/08 v1.2.3 pgfplotstable cells]
\RequirePackage{pgfplotstable}
\ExplSyntaxOn
\clist_new:N\l__gradbars_pgf_missing_clist
\tl_new:N\l__gradbars_pgf_value_tl
\dim_new:N\l__gradbars_pgf_width_dim
\dim_new:N\l__gradbars_pgf_plot_dim
\box_new:N\l__gradbars_pgf_box
\pgfkeys{/gradbars/pgf~missing/.code={\clist_set:Nn\l__gradbars_pgf_missing_clist{#1}}}
\cs_new_protected:Npn\__gradbars_pgf_number:n #1
 {\gradbarsValidateFormatter
  \tl_set:Nx\l_tmpa_tl{\gradbars@precision}
  \regex_match:nVF{\A[0-6]\Z}\l_tmpa_tl{\gradbarsFail{Precision~must~be~an~integer~from~0~to~6}}
  \str_if_eq:nnTF{#1}{NA}
   {\gradbars@missingtext}
   {\gradbarsCheckNumber{#1}{pgfplotstable~number}
    \str_if_eq:eeT{\gradbars@format}{percent}
     {\gradbarsCheckNumber{\gradbars@min}{min}\gradbarsCheckNumber{\gradbars@max}{max}
      \ifgradbars@valid\fp_compare:nNnF{\gradbars@min}={0}
       {\gradbarsFail{Percent~format~requires~min=0}}\gradbarsValidatePercentBase\fi}
    \ifgradbars@valid\gradbarsFormatEndpoint{#1}\fi}}
\DeclareDocumentCommand\gradpgfplotstablecell{O{} m m m}
 {\group_begin:\gradbars@validtrue
  \clist_set:Nn\l__gradbars_pgf_missing_clist{NA,N/A,null}
  \gradbarssetup{baseline=text,label=none,#1}
  \gradbarsResolveScaleGroup
  \tl_set:Nx\l__gradbars_pgf_value_tl{#4}\tl_trim_spaces:N\l__gradbars_pgf_value_tl
  \tl_if_empty:NT\l__gradbars_pgf_value_tl{\tl_set:Nn\l__gradbars_pgf_value_tl{NA}}
  \clist_if_in:NVT\l__gradbars_pgf_missing_clist\l__gradbars_pgf_value_tl
   {\tl_set:Nn\l__gradbars_pgf_value_tl{NA}}
  \dim_set:Nn\l__gradbars_pgf_width_dim{#3}
  \dim_compare:nNnF{\l__gradbars_pgf_width_dim}>{0pt}
   {\gradbarsFail{Pgfplotstable~cell~width~must~be~positive}}
  \dim_set_eq:NN\l__gradbars_pgf_plot_dim\l__gradbars_pgf_width_dim
  \str_case_e:nn{\gradbars@label}
   {{outside}{\dim_sub:Nn\l__gradbars_pgf_plot_dim{\gradbars@labelwidth+\gradbars@gap}}
    {left}{\dim_sub:Nn\l__gradbars_pgf_plot_dim{\gradbars@labelwidth+\gradbars@gap}}}
  \str_if_eq:nnF{#2}{number}
   {\dim_compare:nNnF{\l__gradbars_pgf_plot_dim}>{0pt}
     {\gradbarsFail{Pgfplotstable~cell~has~no~remaining~graphic~width}}}
  \ifgradbars@valid
   \pgfkeys{/gradbars/width/.expanded=\dim_use:N\l__gradbars_pgf_plot_dim}
   \hbox_set:Nn\l__gradbars_pgf_box
    {\gradbars@font\str_case:nnF{#2}
      {{bar}{\exp_args:NV\gradbar\l__gradbars_pgf_value_tl}
       {heat}{\use:x{\exp_not:N\gradheat[width=\dim_use:N\l__gradbars_pgf_plot_dim,
          height=\gradbars@height]{\exp_not:V\l__gradbars_pgf_value_tl}}}
       {number}{\exp_args:NV\__gradbars_pgf_number:n\l__gradbars_pgf_value_tl}}
      {\gradbarsFail{Unsupported~pgfplotstable~cell~type:~#2}}}
   \dim_compare:nNnT{\box_wd:N\l__gradbars_pgf_box}>{\l__gradbars_pgf_width_dim+.2pt}
     {\gradbarsFail{Pgfplotstable~graphic~exceeds~cell~width}}
   \makebox[\l__gradbars_pgf_width_dim][c]{\box_use:N\l__gradbars_pgf_box}
  \fi\group_end:}
% Public hooks apply to body cells; pgfplotstable retains control of headers.
\cs_new_protected:Npn\__gradbars_pgf_column_cell:nnn #1#2#3
 {\pgfkeysgetvalue{/pgfplots/table/@preprocessed~cell~content}\l__gradbars_pgf_value_tl
  \tl_set:Nx\l_tmpa_tl
   {\exp_not:N\gradpgfplotstablecell[\exp_not:n{#1}]{#2}{#3}{\exp_not:V\l__gradbars_pgf_value_tl}}
  \pgfkeyslet{/pgfplots/table/@cell~content}\l_tmpa_tl}
\DeclareDocumentCommand\gradpgfplotstablecolumn{O{} m m m}
 {\pgfplotstableset{columns/#2/.append~style={string~type,
   postproc~cell~content/.code={\__gradbars_pgf_column_cell:nnn{#1}{#3}{#4}}}}}
\ExplSyntaxOff
\endinput
