\DeclareDocumentCommand\gradbar{O{} m}{%
  \leavevmode\begingroup
    \gradbarsCaptureTikzAlt
    \gradbars@capturealttrue
    \pgfkeys{/gradbars,#1}%
    \gradbars@capturealtfalse
    % Resolve font-relative dimensions in the surrounding text font.
    \ifpgfpicture
      \pgfinterruptpicture
      \font@name
      \edef\gradbars@resolved{%
        \noexpand\endpgfinterruptpicture
        \def\noexpand\gradbars@width{\the\dimexpr\gradbars@width\relax}%
        \def\noexpand\gradbars@height{\the\dimexpr\gradbars@height\relax}%
        \def\noexpand\gradbars@rounded{\the\dimexpr\gradbars@rounded\relax}%
        \def\noexpand\gradbars@gap{\the\dimexpr\gradbars@gap\relax}%
        \def\noexpand\gradbars@labelwidth{\the\dimexpr\gradbars@labelwidth\relax}%
      }%
      \gradbars@resolved
    \fi
    \def\gradbars@value{#2}%
    \gradbars@render
  \endgroup
}


% v0.0.2: labels, legends and collected table columns.
\def\gradbars@stacknames{}
\def\gradbars@segmentlabels{none}
\def\gradbars@segmentfont{\scriptsize}
\def\gradbars@segmenttextcolor{auto}
\def\gradbars@labeloverflow{auto}
\newif\ifgradbars@legend
\newif\ifgradbars@inside
\newif\ifgradbars@fit
\newsavebox\gradbars@segmentbox
\pgfkeys{/gradbars,
  stack names/.store in=\gradbars@stacknames,
  legend/.is if=gradbars@legend,legend/.default=true,
  segment font/.store in=\gradbars@segmentfont,
  segment text color/.store in=\gradbars@segmenttextcolor,
  segment labels/.is choice,
  segment labels/none/.code=\def\gradbars@segmentlabels{none},
  segment labels/value/.code=\def\gradbars@segmentlabels{value},
  segment labels/percent/.code=\def\gradbars@segmentlabels{percent},
  segment labels/name/.code=\def\gradbars@segmentlabels{name},
  segment labels/name value/.code=\def\gradbars@segmentlabels{name value},
  segment labels/name percent/.code=\def\gradbars@segmentlabels{name percent},
  label overflow/.is choice,
  label overflow/auto/.code=\def\gradbars@labeloverflow{auto},
  label overflow/allow/.code=\def\gradbars@labeloverflow{allow}
}
\def\gradbarsMeasure#1#2#3{%
  \sbox#1{\pgfinterruptpicture\font@name #2#3\endpgfinterruptpicture}}

