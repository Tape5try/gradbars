\cs_new_protected:Npn \gradbarsPlaceSegment
  {
    \pgfmathsetlengthmacro\gradbars@segmentmid{.5*(\gradbars@segmentlo+\gradbars@segmenthi)}
    \gradbars@fittrue
    \ifgradbars@outline\gradbars@fitfalse\fi
    \ifdim\dimexpr\wd\gradbars@segmentbox+4pt\relax>\dimexpr\gradbars@segmenthi-\gradbars@segmentlo\relax
      \gradbars@fitfalse\fi
    \ifdim\dimexpr\ht\gradbars@segmentbox+\dp\gradbars@segmentbox+2pt\relax>\gradbars@height\relax
      \gradbars@fitfalse\fi
    \ifx\gradbars@target\@empty\else
      \pgfmathsetlengthmacro\gradbars@distance{abs(\gradbars@xtarget-\gradbars@segmentmid)}
      \ifdim\gradbars@distance<\dimexpr.5\wd\gradbars@segmentbox+2pt\relax
        \gradbars@fitfalse\fi
    \fi
    \ifgradbars@fit
      \let\gradbars@labelcolor\gradbars@segmenttextcolor
      \str_if_eq:eeT {\gradbars@segmenttextcolor}{auto}{\gradbarsContrast{\gradbars@segmentcolor}}
      \gradbarsMeasure\gradbars@segmentbox\gradbars@segmentfont{\color{\gradbars@labelcolor}\gradbars@segmentcontent}
      \node[inner~sep=0pt,outer~sep=0pt,text=\gradbars@labelcolor]
        [gradbars~label~background]
        at (\gradbars@segmentmid,.5*\gradbars@height){\usebox\gradbars@segmentbox};
    \else
      \pgfmathsetlengthmacro\gradbars@labelx
        {max(.5*\wd\gradbars@segmentbox,min(\gradbars@segmentmid,\gradbars@width-.5*\wd\gradbars@segmentbox))}
      \dim_set:Nn \l__gradbars_labelleft_dim {\gradbars@labelx-.5\wd\gradbars@segmentbox}
      \dim_set:Nn \l__gradbars_labelright_dim {\gradbars@labelx+.5\wd\gradbars@segmentbox}
      \dim_set:Nn \l__gradbars_labelbottom_dim {\gradbars@height+4pt}
      \seq_map_inline:Nn \l__gradbars_occupied_seq {\gradbarsCheckOverlap ##1}
      % Route elevated leaders around earlier label boxes, not through text.
      \dim_set:Nn \l__gradbars_leaderx_dim {\gradbars@segmentmid}
      \dim_compare:nNnT {\l__gradbars_labelbottom_dim} > {\gradbars@height+4pt}
        {
          \dim_set:Nn \l__gradbars_leaderleft_dim {\gradbars@segmentmid}
          \dim_set:Nn \l__gradbars_leaderright_dim {\gradbars@segmentmid}
          \seq_map_inline:Nn \l__gradbars_occupied_seq {\gradbarsLeaderBounds ##1}
          \dim_compare:nNnTF
            {\gradbars@segmentmid-\l__gradbars_leaderleft_dim} <
            {\l__gradbars_leaderright_dim-\gradbars@segmentmid}
            {\dim_set_eq:NN \l__gradbars_leaderx_dim \l__gradbars_leaderleft_dim}
            {\dim_set_eq:NN \l__gradbars_leaderx_dim \l__gradbars_leaderright_dim}
        }
      \seq_put_right:Nx \l__gradbars_occupied_seq
        {{\dim_use:N \l__gradbars_labelleft_dim}{\dim_use:N \l__gradbars_labelright_dim}
          {\dim_eval:n {\l__gradbars_labelbottom_dim+\ht\gradbars@segmentbox+\dp\gradbars@segmentbox}}}
      \dim_set:Nn \l__gradbars_top_dim {\dim_max:nn {\l__gradbars_top_dim}
        {\l__gradbars_labelbottom_dim+\ht\gradbars@segmentbox+\dp\gradbars@segmentbox+3pt}}
      \draw[gradbarsInk!55,line~width=.3pt]
        (\gradbars@segmentmid,\gradbars@height)--
        (\gradbars@segmentmid,\dim_eval:n {\gradbars@height+1pt})--
        (\dim_use:N \l__gradbars_leaderx_dim,\dim_eval:n {\gradbars@height+1pt})--
        (\dim_use:N \l__gradbars_leaderx_dim,\dim_eval:n {\l__gradbars_labelbottom_dim-2pt})--
        (\gradbars@labelx,\dim_eval:n {\l__gradbars_labelbottom_dim-2pt});
      \let\gradbars@labelcolor\gradbars@segmenttextcolor
      \str_if_eq:eeT {\gradbars@segmenttextcolor}{auto}{\def\gradbars@labelcolor{black}}
      \gradbarsMeasure\gradbars@segmentbox\gradbars@segmentfont{\color{\gradbars@labelcolor}\gradbars@segmentcontent}
      \node[anchor=south,inner~sep=0pt,outer~sep=0pt,text=\gradbars@labelcolor]
        at (\gradbars@labelx,\dim_use:N \l__gradbars_labelbottom_dim){\usebox\gradbars@segmentbox};
    \fi
  }


\cs_new_protected:Npn \gradbarsMainBackground
  {
    \def\gradbars@labelcolor{black}
