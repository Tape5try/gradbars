\ProvidesPackage{gradbars-lib-csv}[2026/10/27 v1.1.1 gradbars lib-csv]
\RequirePackage{collcell}
\ExplSyntaxOff
\DeclareDocumentCommand\gradbarscolumn{s m m}{%
  \IfBooleanTF{#1}{\gradbarsDefineCompactColumn{#2}{#3}}{%
    \gradbarsDefineColumn{#2}{#3}}}
\ExplSyntaxOn
\cs_new_protected:Npn \gradbarsDefineColumn #1#2
  {
    \regex_match:nnTF {\A[A-Za-z]\Z} {#1}
      {\expandafter\newcolumntype\expandafter{#1}
        {>{\collectcell{\gradbar[#2]}}l<{\endcollectcell}}}
      {\PackageError{gradbars}{Column~name~must~be~one~ASCII~letter}
        {Choose~a~single~unused~letter,~for~example~G.}}
  }

% Expand directly to \multicolumn: alignment must see \omit before any setup.
\cs_set:Npn \gradbarshead #1 {\multicolumn{1}{c}{#1}}
\dim_new:N \l__gradbars_column_blank_dim
\cs_new_protected:Npn \__gradbars_compact_cell:nn #1#2
  {\tl_if_blank:nTF {#2}
     {\group_begin:
      \gradbarssetup{#1}
      \dim_set:Nn\l__gradbars_column_blank_dim{\gradbars@width}
      \dim_compare:nNnTF{\l__gradbars_column_blank_dim}>{0pt}
        {\hbox_to_wd:nn{\l__gradbars_column_blank_dim}{\hfil}}
        {\gradbarsFail{Width~must~be~positive}}
      \group_end:}
     {\gradbar[baseline=text,label=inside,label~align=cell,#1]{#2}}}
\cs_new_protected:Npn \gradbarsDefineCompactColumn #1#2
  {\regex_match:nnTF {\A[A-Za-z]\Z}{#1}
     {\clist_if_in:nnTF{c,l,r,p,m,b,w,W}{#1}
        {\__gradbars_public_error:n{Column~already~defined~or~reserved:~#1}}
        {\cs_if_exist:cTF{NC@find@#1}
          {\__gradbars_public_error:n{Column~already~defined~or~reserved:~#1}}
          {\newcolumntype{#1}
            {>{\collectcell{\__gradbars_compact_cell:nn{#2}}}c<{\endcollectcell}}}}}
     {\__gradbars_public_error:n{Column~name~must~be~one~ASCII~letter}}}

\ExplSyntaxOff
\ExplSyntaxOn
% CSV is read as character data; fields are never executed as TeX.
\ior_new:N \l__gradbars_csv_ior
\prop_new:N \l__gradbars_csv_prop
\seq_new:N \l__gradbars_csv_fields_seq
\tl_new:N \l__gradbars_csv_field_tl
\tl_new:N \l__gradbars_csv_line_tl
\tl_new:N \l__gradbars_csv_value_tl
\tl_new:N \l__gradbars_csv_table_tl
\clist_new:N \l__gradbars_csv_missing_clist
\int_new:N \l__gradbars_csv_state_int
\int_new:N \l__gradbars_csv_row_int
\int_new:N \l__gradbars_csv_col_int
\int_new:N \l__gradbars_csv_width_int
\fp_new:N \l__gradbars_csv_min_fp
\fp_new:N \l__gradbars_csv_max_fp
\keys_define:nn {gradbars/csv}
  {missing .clist_set:N=\l__gradbars_csv_missing_clist}
\cs_generate_variant:Nn \prop_put:Nnn {Nxn,Nxx,NVx}
\cs_generate_variant:Nn \prop_get:NnN {cxN}
\cs_generate_variant:Nn \prop_if_in:NnTF {cxTF}
\cs_new_protected:Npn \gradbarsCSVField
  {\tl_trim_spaces:N \l__gradbars_csv_field_tl
   \seq_put_right:NV \l__gradbars_csv_fields_seq \l__gradbars_csv_field_tl
   \tl_clear:N \l__gradbars_csv_field_tl
   \int_zero:N \l__gradbars_csv_state_int}
\cs_new_protected:Npn \gradbarsCSVParse #1
  {
    \seq_clear:N \l__gradbars_csv_fields_seq
    \tl_clear:N \l__gradbars_csv_field_tl
    \int_zero:N \l__gradbars_csv_state_int
    % states: 0=unquoted, 1=quoted, 2=closing quote, 3=trailing space.
    \str_map_inline:nn {#1}
      {
        \int_case:nn {\l__gradbars_csv_state_int}
          {
            {0}{\str_case:nnF {##1}
              {{,}{\gradbarsCSVField}
               {"}{\tl_if_blank:VTF \l__gradbars_csv_field_tl
                    {\tl_clear:N \l__gradbars_csv_field_tl\int_set:Nn \l__gradbars_csv_state_int {1}}
                    {\gradbarsFail{Quote~inside~unquoted~CSV~field}}}}
              {\tl_put_right:Nn \l__gradbars_csv_field_tl {##1}}}
            {1}{\str_if_eq:nnTF {##1}{"}
              {\int_set:Nn \l__gradbars_csv_state_int {2}}
              {\tl_put_right:Nn \l__gradbars_csv_field_tl {##1}}}
            {2}{\str_case:nnF {##1}
              {{"}{\tl_put_right:Nn \l__gradbars_csv_field_tl {"}\int_set:Nn \l__gradbars_csv_state_int {1}}
               {,}{\gradbarsCSVField}}
              {\str_if_eq:nnTF {##1}{~}
                {\int_set:Nn \l__gradbars_csv_state_int {3}}
                {\gradbarsFail{Unexpected~text~after~CSV~quote}}}}
            {3}{\str_if_eq:nnTF {##1}{,}{\gradbarsCSVField}
              {\str_if_eq:nnF {##1}{~}{\gradbarsFail{Unexpected~text~after~CSV~quote}}}}
          }
      }
    \int_compare:nNnT {\l__gradbars_csv_state_int} = {1}
      {\gradbarsFail{Unclosed~CSV~quote;~multiline~fields~are~not~supported}}
    \gradbarsCSVField
  }
\cs_new_protected:Npn \gradbarsCSVLine #1
  {
    \tl_set:Nn \l__gradbars_csv_line_tl {#1}
    % pdfTeX reads UTF-8 as bytes; Unicode engines read a single BOM character.
    \sys_if_engine_pdftex:TF
      {\regex_replace_once:nnN {\A\x{EF}\x{BB}\x{BF}} {} \l__gradbars_csv_line_tl}
      {\regex_replace_once:nnN {\A\x{FEFF}} {} \l__gradbars_csv_line_tl}
    \tl_if_blank:VF \l__gradbars_csv_line_tl
      {
        \exp_args:NV \gradbarsCSVParse \l__gradbars_csv_line_tl
        \int_compare:nNnTF {\l__gradbars_csv_row_int} = {0}
          {
            \int_set:Nn \l__gradbars_csv_width_int {\seq_count:N \l__gradbars_csv_fields_seq}
            \int_zero:N \l__gradbars_csv_col_int
            \seq_map_inline:Nn \l__gradbars_csv_fields_seq
              {\int_incr:N \l__gradbars_csv_col_int
               \tl_if_blank:nT {##1}{\gradbarsFail{CSV~header~must~not~be~empty}}
               \prop_if_in:NnT \l__gradbars_csv_prop {col/##1}{\gradbarsFail{Duplicate~CSV~header:~##1}}
               \prop_put:Nnx \l__gradbars_csv_prop {col/##1}{\int_use:N \l__gradbars_csv_col_int}}
          }
          {
            \int_compare:nNnF {\seq_count:N \l__gradbars_csv_fields_seq} = {\l__gradbars_csv_width_int}
              {\gradbarsFail{CSV~row~has~wrong~field~count}}
            \int_zero:N \l__gradbars_csv_col_int
            \seq_map_inline:Nn \l__gradbars_csv_fields_seq
              {\int_incr:N \l__gradbars_csv_col_int
               \prop_put:Nxn \l__gradbars_csv_prop
                 {row/\int_use:N \l__gradbars_csv_row_int/\int_use:N \l__gradbars_csv_col_int}{##1}}
          }
        \int_incr:N \l__gradbars_csv_row_int
      }
  }
\DeclareDocumentCommand\gradbarsloadcsv{O{} m m}
  {
    \gradbars@validtrue
    \regex_match:nnF {\A[A-Za-z][A-Za-z0-9_\-]*\Z}{#2}
      {\gradbarsFail{CSV~dataset~name~must~start~with~an~ASCII~letter}}
    \clist_set:Nn \l__gradbars_csv_missing_clist {NA,N/A,null}
    \keys_set:nn {gradbars/csv}{#1}
    \prop_clear:N \l__gradbars_csv_prop
    \int_zero:N \l__gradbars_csv_row_int
    \file_if_exist:nTF {#3}
      {\ior_open:Nn \l__gradbars_csv_ior {#3}
       \ior_str_map_inline:Nn \l__gradbars_csv_ior {\gradbarsCSVLine{##1}}
       \ior_close:N \l__gradbars_csv_ior}
      {\gradbarsFail{CSV~file~not~found:~#3}}
    \int_compare:nNnF {\l__gradbars_csv_row_int} > {0}{\gradbarsFail{CSV~requires~a~header}}
    \ifgradbars@valid
      \prop_put:Nnx \l__gradbars_csv_prop {rows}{\int_eval:n {\l__gradbars_csv_row_int-1}}
      \prop_put:NnV \l__gradbars_csv_prop {missing}\l__gradbars_csv_missing_clist
      \prop_if_exist:cF {l__gradbars_csv_#2_prop}{\prop_new:c {l__gradbars_csv_#2_prop}}
      \prop_set_eq:cN {l__gradbars_csv_#2_prop}\l__gradbars_csv_prop
    \fi
  }
\cs_new_protected:Npn \gradbarsCSVColumn #1#2
  {
    \gradbars@validtrue
    \prop_if_exist:cTF {l__gradbars_csv_#1_prop}
      {\prop_if_in:cxTF {l__gradbars_csv_#1_prop}{col/\tl_to_str:n {#2}}
        {\prop_get:cxN {l__gradbars_csv_#1_prop}{col/\tl_to_str:n {#2}}\l_tmpa_tl
         \int_set:Nn \l__gradbars_csv_col_int {\l_tmpa_tl}}
        {\gradbarsFail{Unknown~CSV~column:~#2}}}
      {\gradbarsFail{Unknown~CSV~dataset:~#1}}
  }
\cs_new_protected:Npn \gradbarsCSVGet #1#2#3
  {
    \gradbarsCSVColumn{#1}{#3}
    \regex_match:nnF {\A[1-9][0-9]*\Z}{#2}{\gradbarsFail{CSV~row~must~be~a~positive~integer}}
    \ifgradbars@valid
      \prop_if_in:cxTF {l__gradbars_csv_#1_prop}{row/#2/\int_use:N \l__gradbars_csv_col_int}
        {\prop_get:cxN {l__gradbars_csv_#1_prop}{row/#2/\int_use:N \l__gradbars_csv_col_int}\l__gradbars_csv_value_tl}
        {\gradbarsFail{CSV~row~out~of~range}}
    \fi
  }
\cs_new_protected:Npn \gradbarsCSVNumber #1
  {
    \prop_get:cnN {l__gradbars_csv_#1_prop}{missing}\l_tmpa_tl
    \clist_set:NV \l__gradbars_csv_missing_clist \l_tmpa_tl
    \bool_set_false:N \l_tmpa_bool
    \tl_if_blank:VT \l__gradbars_csv_value_tl {\bool_set_true:N \l_tmpa_bool}
    \clist_map_inline:Nn \l__gradbars_csv_missing_clist
      {\str_if_eq:eeT {\l__gradbars_csv_value_tl}{\tl_to_str:n {##1}}{\bool_set_true:N \l_tmpa_bool}}
    \bool_if:NTF \l_tmpa_bool
      {\tl_set:Nn \l__gradbars_csv_value_tl {NA}}
      {\gradbarsCheckNumber{\l__gradbars_csv_value_tl}{CSV~numeric~cell}}
  }
\DeclareDocumentCommand\gradbarscsvcell{m m m}
  {\group_begin:\gradbarsCSVGet{#1}{#2}{#3}
   \ifgradbars@valid\tl_use:N \l__gradbars_csv_value_tl\fi\group_end:}
\DeclareDocumentCommand\gradbarcsv{O{} m m m}
  {\group_begin:\gradbarsCSVGet{#2}{#3}{#4}
   \ifgradbars@valid\gradbarsCSVNumber{#2}
     \ifgradbars@valid\gradbar[#1]{\l__gradbars_csv_value_tl}\fi\fi\group_end:}
\cs_new_protected:Npn \gradbarsCSVRange #1#2
  {
    \gradbarsCSVColumn{#1}{#2}
    \fp_zero:N \l__gradbars_csv_min_fp
    \fp_zero:N \l__gradbars_csv_max_fp
    \ifgradbars@valid
      \int_step_inline:nn {\prop_item:cn {l__gradbars_csv_#1_prop}{rows}}
        {\prop_get:cxN {l__gradbars_csv_#1_prop}{row/##1/\int_use:N \l__gradbars_csv_col_int}\l__gradbars_csv_value_tl
         \gradbarsCSVNumber{#1}
         \ifgradbars@valid
           \str_if_eq:VnF \l__gradbars_csv_value_tl {NA}
             {\fp_set:Nn \l__gradbars_csv_min_fp {min(\l__gradbars_csv_min_fp,\l__gradbars_csv_value_tl)}
              \fp_set:Nn \l__gradbars_csv_max_fp {max(\l__gradbars_csv_max_fp,\l__gradbars_csv_value_tl)}}
         \fi}
      % Keep a positive upper limit even for all-zero/all-missing/negative columns.
      \fp_compare:nNnT {\l__gradbars_csv_max_fp} = {0}{\fp_set:Nn \l__gradbars_csv_max_fp {1}}
    \fi
  }
\DeclareDocumentCommand\gradbarscsvstyle{m m m}
  {\gradbarsCSVRange{#2}{#3}
   \ifgradbars@valid
     \cs_set:cpx {gradbars@style@#1}
       {min=\fp_to_decimal:N \l__gradbars_csv_min_fp,max=\fp_to_decimal:N \l__gradbars_csv_max_fp}
   \fi}
\DeclareDocumentCommand\gradbarscsvtable{O{} m m m}
  {
    \group_begin:
    \gradbarsCSVRange{#2}{#4}
    \ifgradbars@valid
      \tl_set:Nx \l__gradbars_csv_table_tl
        {\exp_not:N \gradbarssetup{min=\fp_to_decimal:N \l__gradbars_csv_min_fp,
          max=\fp_to_decimal:N \l__gradbars_csv_max_fp}
         \exp_not:N \begin{tabular}{@{}ll@{}}\exp_not:N \hline
         \tl_to_str:n {#3}&\tl_to_str:n {#4}\exp_not:N \\\exp_not:N \hline}
      \int_step_inline:nn {\prop_item:cn {l__gradbars_csv_#2_prop}{rows}}
        {\gradbarsCSVGet{#2}{##1}{#3}
         \ifgradbars@valid
           \tl_put_right:Nx \l__gradbars_csv_table_tl
             {\exp_not:V \l__gradbars_csv_value_tl &
              \exp_not:N \gradbarcsv[\exp_not:n {#1}]{#2}{##1}{\exp_not:n {#4}}\exp_not:N \\}
         \fi}
      \tl_put_right:Nn \l__gradbars_csv_table_tl {\hline\end{tabular}}
      \ifgradbars@valid\tl_use:N \l__gradbars_csv_table_tl\fi
    \fi
    \group_end:
  }
