\ProvidesPackage{gradbars-keys}[2026/10/27 v1.1.1 gradbars keys]
\pgfkeys{/gradbars/.is family,/gradbars,
  style/.code={\gradbarsUseStyle{#1}},
  missing text/.store in=\gradbars@missingtext,
  number format/.is choice,
  number format/fixed/.code=\def\gradbars@numberformat{fixed},
  number format/grouped/.code=\def\gradbars@numberformat{grouped},
  number format/scientific/.code=\def\gradbars@numberformat{scientific},
  band/.store in=\gradbars@band,
  band color/.store in=\gradbars@bandcolor,
  band opacity/.store in=\gradbars@bandopacity,
  stack colors/.store in=\gradbars@stackcolors,
  width/.store in=\gradbars@width,
  height/.store in=\gradbars@height,
  max/.store in=\gradbars@max,
  min/.store in=\gradbars@min,
  scale group/.store in=\gradbars@scalegroup,
  percent base/.store in=\gradbars@percentbase,
  rounded/.store in=\gradbars@rounded,
  target/.store in=\gradbars@target,
  target color/.store in=\gradbars@targetcolor,
  negative color/.store in=\gradbars@negativecolor,
  negative fill/.is choice,
  negative fill/solid/.code=\gradbars@negativegradientfalse,
  negative fill/gradient/.code=\gradbars@negativegradienttrue,
  negative left color/.code={\def\gradbars@negativeleft{#1}\gradbars@negativegradienttrue},
  negative right color/.code={\def\gradbars@negativeright{#1}\gradbars@negativegradienttrue},
  thresholds/.store in=\gradbars@thresholds,
  threshold colors/.store in=\gradbars@thresholdcolors,
  error/.style={error minus=#1,error plus=#1},
  error minus/.store in=\gradbars@errorminus,
  error plus/.store in=\gradbars@errorplus,
  error color/.store in=\gradbars@errorcolor,
  precision/.store in=\gradbars@precision,
  unit/.store in=\gradbars@unit,
  text/.store in=\gradbars@text,
  alt/.store in=\gradbars@alt,
  accessibility/.is choice,
  accessibility/auto/.code=\def\gradbars@accessibility{auto},
  accessibility/artifact/.code=\def\gradbars@accessibility{artifact},
  accessibility/off/.code=\def\gradbars@accessibility{off},
  label gap/.store in=\gradbars@gap,
  label width/.store in=\gradbars@labelwidth,
  label align/.is choice,
  label align/graphic/.code=\def\gradbars@labelalign{graphic},
  label align/cell/.code=\def\gradbars@labelalign{cell},
  font/.store in=\gradbars@font,
  left color/.store in=\gradbars@left,
  right color/.store in=\gradbars@right,
  track color/.store in=\gradbars@track,
  text color/.store in=\gradbars@textcolor,
  color/.style={fill=solid,left color=#1},
  fill/.is choice,
  fill/gradient/.code=\gradbars@gradienttrue,
  fill/solid/.code=\gradbars@gradientfalse,
  label/.is choice,
  label/outside/.code=\def\gradbars@label{outside},
  label/inside/.code=\def\gradbars@label{inside},
  label/none/.code=\def\gradbars@label{none},
  label/end/.code=\def\gradbars@label{end},
  label/auto/.code=\def\gradbars@label{auto},
  label/left/.code=\def\gradbars@label{left},
  baseline/.is choice,
  baseline/auto/.code=\def\gradbars@baseline{auto},
  baseline/text/.code=\def\gradbars@baseline{text},
  baseline/center/.code=\def\gradbars@baseline{center},
  baseline/bottom/.code=\def\gradbars@baseline{bottom},
  baseline shift/.store in=\gradbars@baselineshift,
  value format/.is choice,
  value format/value/.code=\def\gradbars@format{value},
  value format/percent/.code=\def\gradbars@format{percent},
  overflow/.is choice,
  overflow/clip/.code=\def\gradbars@overflow{clip},
  overflow/error/.code=\def\gradbars@overflow{error},
  theme/.is choice,
  theme/blue/.style={fill=gradient,left color=gradbarsBlue,
    right color=gradbarsBlueLight,track color=gradbarsTrack,text color=gradbarsInk},
  theme/teal/.style={fill=gradient,left color=gradbarsTeal,
    right color=gradbarsTealLight,track color=gradbarsTrack,text color=gradbarsInk},
  theme/solid/.style={fill=solid,left color=gradbarsBlue,
    right color=gradbarsBlue,track color=gradbarsTrack,text color=gradbarsInk},
  theme/gray/.style={fill=solid,left color=black!65,
    right color=black!65,track color=black!8,text color=black},
  theme/lbyellow/.style={fill=gradient,left color=lightblue!90,
    right color=lightyellow!60,track color=gradbarsTrack,text color=gradbarsInk},
  theme/viblue/.style={fill=gradient,left color=violet!20,
    right color=lightblue!70,track color=gradbarsTrack,text color=gradbarsInk},
  theme/cyblu/.style={fill=gradient,left color=cyan,
    right color=blue!20,track color=gradbarsTrack,text color=gradbarsInk},
  theme/violet/.style={fill=gradient,left color=gradbarsViolet,
    right color=gradbarsVioletLight,track color=gradbarsViolet!6,text color=gradbarsInk},
  theme/orange/.style={fill=gradient,left color=gradbarsWarmOrange,
    right color=gradbarsWarmOrangeLight,track color=gradbarsWarmOrange!6,text color=gradbarsInk},
  theme/forest/.style={fill=gradient,left color=gradbarsForest,
    right color=gradbarsForestLight,track color=gradbarsForest!6,text color=gradbarsInk},
}
\endinput
