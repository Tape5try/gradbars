%<core>\cs_new_eq:NN \gradbarsValidateBeforeShapes \gradbarsValidateExtras
%<core>\cs_set_protected:Npn \gradbarsValidateExtras
%<core>  {
%<core>    \gradbarsValidateBeforeShapes
%<core>    \clist_map_inline:nn {markersize,stemwidth,outlinewidth}
%<core>      {\dim_compare:nNnF {\use:c {gradbars@##1}} > {0pt}
%<core>        {\gradbarsFail{Marker~and~line~sizes~must~be~positive}}}
%<core>    \dim_compare:nNnT {\gradbars@rowpadding} < {0pt}
%<core>      {\gradbarsFail{Row~padding~must~be~nonnegative}}
%<core>    \ifgradbars@stack
%<core>      \str_if_eq:eeF {\gradbars@shape}{bar}{\gradbarsFail{Stacked~bars~require~shape=bar}}
%<core>    \fi
%<core>    \ifgradbars@compare
%<core>      \str_case_e:nnF {\gradbars@shape}{{bar}{}{dumbbell}{}}
%<core>        {\gradbarsFail{Comparison~requires~shape=bar~or~dumbbell}}
%<core>      \gradbarsCheckNumber{\gradbars@compareratio}{compare~ratio}
%<core>      \gradbars@referencemissingfalse
%<core>      \tl_set:Nx \l_tmpa_tl {\gradbars@reference}\tl_trim_spaces:N \l_tmpa_tl
%<core>      \tl_if_empty:NT \l_tmpa_tl {\gradbars@referencemissingtrue}
%<core>      \str_if_eq:VnT \l_tmpa_tl {NA}{\gradbars@referencemissingtrue}
%<core>      \ifgradbars@referencemissing\else\gradbarsCheckNumber{\gradbars@reference}{reference}\fi
%<core>      \ifgradbars@valid
%<core>        \fp_compare:nF {0<\gradbars@compareratio<1}{\gradbarsFail{Compare~ratio~must~lie~strictly~between~0~and~1}}
%<core>        \ifgradbars@referencemissing\else
%<core>          \fp_compare:nNnT {\gradbars@min} = {0}
%<core>            {\fp_compare:nNnT {\gradbars@reference} < {0}
%<core>              {\gradbarsFail{Negative~reference~requires~a~negative~min}}}
%<core>          \gradbarsRange{Reference}{\gradbars@reference}
%<core>        \fi
%<core>      \fi
%<core>    \fi
%<core>    \ifgradbars@rangemode
%<core>      \str_if_eq:eeF {\gradbars@shape}{bar}{\gradbarsFail{Range~requires~shape=bar}}
%<core>      \ifgradbars@error\gradbarsFail{Range~bars~do~not~accept~error~whiskers}\fi
%<core>      \clist_if_empty:NF \l__gradbars_thresholds_clist
%<core>        {\gradbarsFail{Range~bars~do~not~accept~thresholds}}
%<core>      \gradbars@rangemissingfalse
%<core>      \tl_set:Nx \l_tmpa_tl {\gradbars@rangelo}\tl_trim_spaces:N \l_tmpa_tl
%<core>      \tl_if_empty:NT \l_tmpa_tl {\gradbars@rangemissingtrue}
%<core>      \str_if_eq:VnT \l_tmpa_tl {NA}{\gradbars@rangemissingtrue}
%<core>      \ifgradbars@rangemissing
%<core>        \ifgradbars@missing\else\gradbarsFail{Both~range~endpoints~must~be~present~or~missing}\fi
%<core>      \else
%<core>        \ifgradbars@missing\gradbarsFail{Both~range~endpoints~must~be~present~or~missing}\fi
%<core>        \gradbarsCheckNumber{\gradbars@rangelo}{range~lower~endpoint}
%<core>      \fi
%<core>      \tl_if_empty:oF {\gradbars@rangepoint}{\gradbarsCheckNumber{\gradbars@rangepoint}{range~point}}
%<core>      \ifgradbars@valid
%<core>        \ifgradbars@missing
%<core>          \tl_if_empty:oF {\gradbars@rangepoint}{\gradbarsFail{Missing~range~cannot~have~a~point}}
%<core>        \else
%<core>          \fp_compare:nNnT {\gradbars@rangelo} > {\gradbars@rangehi}
%<core>            {\gradbarsFail{Range~lower~endpoint~must~not~exceed~upper}}
%<core>          \fp_compare:nNnT {\gradbars@min} = {0}
%<core>            {\fp_compare:nNnT {\gradbars@rangelo} < {0}
%<core>              {\gradbarsFail{Negative~range~requires~a~negative~min}}}
%<core>          \gradbarsRange{Range~lower~endpoint}{\gradbars@rangelo}
%<core>          \tl_if_empty:oF {\gradbars@rangepoint}
%<core>            {\fp_compare:nF {\gradbars@rangelo<=\gradbars@rangepoint<=\gradbars@rangehi}
%<core>              {\gradbarsFail{Range~point~must~lie~between~endpoints}}}
%<core>          \cs_set:Npx \gradbars@start {\gradbarsPosition{\gradbars@rangelo}}
%<core>          \cs_set:Npx \gradbars@stop {\gradbarsPosition{\gradbars@rangehi}}
%<core>        \fi
%<core>      \fi
%<core>    \else
%<core>      \tl_if_empty:oF {\gradbars@rangepoint}{\gradbarsFail{Range~point~requires~gradrange}}
%<core>    \fi
%<core>  }
