\NewDocumentCommand\gradbarslegend{O{} m}{%
  \begingroup\pgfkeys{/gradbars,#1,stack names={#2}}%
  \begingroup\font@name
    \edef\gradbars@next{\endgroup
      \def\noexpand\gradbars@width{\the\dimexpr\gradbars@width\relax}}%
  \gradbars@next
  \gradbarsStandaloneLegend
  \endgroup}
\ExplSyntaxOn
\cs_new_protected:Npn \gradbarsStandaloneLegend
  {
    \gradbars@validtrue
    \clist_set:No \l__gradbars_names_clist {\gradbars@stacknames}
    \clist_set:No \l__gradbars_stackcolors_clist {\gradbars@stackcolors}
    \clist_if_empty:NT \l__gradbars_names_clist {\gradbarsFail{Legend~names~must~not~be~empty}}
    \clist_if_empty:NT \l__gradbars_stackcolors_clist {\gradbarsFail{Stack~colors~must~not~be~empty}}
    \ifdim\gradbars@width>14pt\else\gradbarsFail{Legend~width~must~exceed~14pt}\fi
    \ifgradbars@valid
      \ifpgfpicture \gradbarsDrawLegend
      \else\tikz[baseline=0pt]{\gradbarsDrawLegend}\fi
    \fi
  }
