\NeedsTeXFormat{LaTeX2e}[2020/10/01]
\ProvidesPackage{gradbars}[2026/10/02 v0.0.1 Inline data bars for LaTeX]
\RequirePackage{tikz}
\RequirePackage{xparse}
\RequirePackage{expl3}
\usetikzlibrary{shadings}

\definecolor{gradbarsBlue}{HTML}{2563EB}
\definecolor{gradbarsBlueLight}{HTML}{93C5FD}
\definecolor{gradbarsTeal}{HTML}{0F766E}
\definecolor{gradbarsTealLight}{HTML}{5EEAD4}
\definecolor{gradbarsInk}{HTML}{243247}
\definecolor{gradbarsTrack}{HTML}{EDF2F7}
% Public built-in palette.
\definecolor{lightgreen}{RGB}{144,238,144}
\definecolor{lightyellow}{RGB}{255,255,224}
\definecolor{lightblue}{RGB}{173,216,230}
\definecolor{lightred}{RGB}{255,160,122}
\definecolor{rose}{RGB}{255,102,204}
\definecolor{skyblue}{RGB}{135,206,235}
\definecolor{gold}{RGB}{255,215,0}
\definecolor{lavender}{RGB}{230,230,250}
\definecolor{peach}{RGB}{255,218,185}
\newif\ifgradbars@valid
\newif\ifgradbars@gradient
\def\gradbars@width{24mm}
\def\gradbars@height{1.5ex}
\def\gradbars@max{100}
\def\gradbars@min{0}
\def\gradbars@rounded{0pt}
\def\gradbars@target{}
\def\gradbars@targetcolor{gradbarsInk}
\def\gradbars@negativecolor{lightred}
\def\gradbars@thresholds{}
\def\gradbars@thresholdcolors{lightred,gold,lightgreen}
\def\gradbars@errorminus{}
\def\gradbars@errorplus{}
\def\gradbars@errorcolor{gradbarsInk}
\newif\ifgradbars@error
\newsavebox\gradbars@labelbox
\def\gradbars@precision{1}
\def\gradbars@unit{}
\def\gradbars@text{}
\def\gradbars@label{outside}
\def\gradbars@format{value}
\def\gradbars@overflow{clip}
\def\gradbars@gap{.6em}
\def\gradbars@labelwidth{4.5em}
\def\gradbars@font{\relax}
\newif\ifgradbars@missing
\newif\ifgradbars@stack
\newcount\gradbars@styledepth
\def\gradbars@missingtext{--}
\def\gradbars@numberformat{fixed}
\def\gradbars@band{}
\def\gradbars@bandcolor{gold}
\def\gradbars@bandopacity{0.3}
\def\gradbars@stackcolors{gradbarsBlue,gradbarsTeal,gold}
