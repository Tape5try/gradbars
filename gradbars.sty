}
\pgfkeys{/gradbars,theme=blue}
\NewDocumentCommand\gradbarssetup{m}{\pgfkeys{/gradbars,#1}}
% Style definitions follow ordinary TeX grouping, like setup.
\NewDocumentCommand\gradbarsstyle{m m}{%
  \expandafter\def\csname gradbars@style@#1\endcsname{#2}}
\def\gradbarsUseStyle#1{%
  \ifcsname gradbars@style@#1\endcsname
    \ifnum\gradbars@styledepth<32
      \advance\gradbars@styledepth by 1
      \expandafter\let\expandafter\gradbars@styleoptions\csname gradbars@style@#1\endcsname
      \expandafter\pgfkeysalso\expandafter{\gradbars@styleoptions}%
      \advance\gradbars@styledepth by -1
    \else\PackageError{gradbars}{Style nesting exceeds 32 levels}{Check for recursive styles.}\fi
  \else\PackageError{gradbars}{Unknown style: #1}{Define it with gradbarsstyle first.}\fi
}

% Validate before drawing; floating point arithmetic also supports large counts.
\ExplSyntaxOn
\cs_new_protected:Npn \gradbarsCheckNumber #1#2
  {
    \tl_set:Nx \l_tmpa_tl {#1}
    \tl_trim_spaces:N \l_tmpa_tl
    \regex_match:nVTF { \A [\+\-]? ( \d+ (\.\d*)? | \.\d+ ) \Z }
      \l_tmpa_tl { }
      {
        \gradbars@validfalse
        \PackageError{gradbars}{Invalid~#2:~expected~a~decimal~number}
          {Use~0,~86.5,~or~125000.~Expressions~are~not~accepted.}
      }
  }

\cs_new_protected:Npn \gradbarsFail #1
  {\gradbars@validfalse \PackageError{gradbars}{#1}{Check~the~gradbars~options~and~data.}}
\cs_new_protected:Npn \gradbarsRange #1#2
  {
    \fp_compare:nT {#2 < \gradbars@min || #2 > \gradbars@max}
      {
        \str_if_eq:eeTF {\gradbars@overflow}{error}
          {\gradbarsFail{#1~exceeds~range}}
          {\PackageWarning{gradbars}{#1~exceeds~range;~bar~clipped,~label~unchanged}}
      }
  }
\cs_new:Npn \gradbarsPosition #1
  {\fp_eval:n {(max(\gradbars@min,min(\gradbars@max,#1))-\gradbars@min)/
    (\gradbars@max-\gradbars@min)}}
\clist_new:N \l__gradbars_thresholds_clist
\clist_new:N \l__gradbars_colors_clist
\cs_new_protected:Npn \gradbarsValidate
  {
    \gradbars@missingfalse
    \tl_set:Nx \l_tmpa_tl {\gradbars@value}
    \tl_trim_spaces:N \l_tmpa_tl
    \tl_if_empty:NT \l_tmpa_tl {\gradbars@missingtrue}
    \str_if_eq:VnT \l_tmpa_tl {NA} {\gradbars@missingtrue}
    \ifgradbars@missing \def\gradbars@value{0}\fi
    \gradbarsCheckNumber{\gradbars@value}{value}
    \gradbarsCheckNumber{\gradbars@min}{min}
    \gradbarsCheckNumber{\gradbars@max}{max}
    \tl_set:Nx \l_tmpa_tl {\gradbars@precision}
    \regex_match:nVTF {\A [0-6] \Z} \l_tmpa_tl { }
      {\gradbarsFail{Precision~must~be~an~integer~from~0~to~6}}
    \ifgradbars@valid
      \fp_compare:nNnF {\gradbars@max} > {0}
        {\gradbarsFail{Max~must~be~greater~than~zero}}
      \fp_compare:nNnT {\gradbars@min} > {0}
        {\gradbarsFail{Min~must~be~zero~or~negative}}
      \fp_compare:nNnT {\gradbars@min} = {0}
        {\fp_compare:nNnT {\gradbars@value} < {0}
          {\gradbarsFail{Negative~values~require~a~negative~min}}}
      \str_if_eq:eeT {\gradbars@format}{percent}
        {\fp_compare:nNnT {\gradbars@min} < {0}
          {\gradbarsFail{Percent~format~requires~min=0}}}
    \fi
    \tl_if_empty:oF {\gradbars@target}
      {\gradbarsCheckNumber{\gradbars@target}{target}}
    \gradbars@errorfalse
    \tl_if_empty:oF {\gradbars@errorminus}{\gradbars@errortrue}
    \tl_if_empty:oF {\gradbars@errorplus}{\gradbars@errortrue}
    \ifgradbars@error
      \tl_if_empty:oT {\gradbars@errorminus}{\def\gradbars@errorminus{0}}
      \tl_if_empty:oT {\gradbars@errorplus}{\def\gradbars@errorplus{0}}
      \gradbarsCheckNumber{\gradbars@errorminus}{error~minus}
      \gradbarsCheckNumber{\gradbars@errorplus}{error~plus}
    \fi
    \clist_set:Nx \l__gradbars_thresholds_clist {\gradbars@thresholds}
    \clist_set:Nx \l__gradbars_colors_clist {\gradbars@thresholdcolors}
    \clist_if_empty:NF \l__gradbars_thresholds_clist
      {
        \int_compare:nNnF {\clist_count:N \l__gradbars_thresholds_clist} = {2}
          {\gradbarsFail{Thresholds~must~contain~two~values}}
        \int_compare:nNnF {\clist_count:N \l__gradbars_colors_clist} = {3}
          {\gradbarsFail{Threshold~colors~must~contain~three~colors}}
        \clist_map_inline:Nn \l__gradbars_thresholds_clist
          {\gradbarsCheckNumber{##1}{threshold}}
      }
    \ifgradbars@valid
      \gradbarsRange{Value}{\gradbars@value}
      \tl_if_empty:oF {\gradbars@target}
        {
          \fp_compare:nT {\gradbars@target < \gradbars@min || \gradbars@target > \gradbars@max}
            {\gradbarsFail{Target~must~lie~within~range}}
          \cs_set:Npx \gradbars@targetpos {\gradbarsPosition{\gradbars@target}}
        }
      \ifgradbars@error
        \fp_compare:nT {\gradbars@errorminus<0 || \gradbars@errorplus<0}
          {\gradbarsFail{Error~magnitudes~must~be~nonnegative}}
        \ifgradbars@missing\else
        \gradbarsRange{Error~lower~endpoint}{\gradbars@value-\gradbars@errorminus}
        \gradbarsRange{Error~upper~endpoint}{\gradbars@value+\gradbars@errorplus}
        \cs_set:Npx \gradbars@errorlo
          {\gradbarsPosition{\gradbars@value-\gradbars@errorminus}}
        \cs_set:Npx \gradbars@errorhi
          {\gradbarsPosition{\gradbars@value+\gradbars@errorplus}}
        \fi
      \fi
      \cs_set:Npx \gradbars@zero {\gradbarsPosition{0}}
      \cs_set:Npx \gradbars@end {\gradbarsPosition{\gradbars@value}}
      \cs_set:Npx \gradbars@start {\fp_eval:n {min(\gradbars@zero,\gradbars@end)}}
      \cs_set:Npx \gradbars@stop {\fp_eval:n {max(\gradbars@zero,\gradbars@end)}}
      \fp_compare:nNnT {\gradbars@value} < {0}
        {\gradbars@gradientfalse \let\gradbars@left\gradbars@negativecolor}
      \clist_if_empty:NF \l__gradbars_thresholds_clist
        {
          \fp_compare:nNnF {\clist_item:Nn \l__gradbars_thresholds_clist {1}}
            < {\clist_item:Nn \l__gradbars_thresholds_clist {2}}
            {\gradbarsFail{Thresholds~must~be~strictly~increasing}}
          \int_set:Nn \l_tmpa_int {1}
          \fp_compare:nNnF {\gradbars@value}
            < {\clist_item:Nn \l__gradbars_thresholds_clist {1}}
            {\int_set:Nn \l_tmpa_int {2}}
          \fp_compare:nNnF {\gradbars@value}
            < {\clist_item:Nn \l__gradbars_thresholds_clist {2}}
            {\int_set:Nn \l_tmpa_int {3}}
          \cs_set:Npx \gradbars@left
            {\clist_item:Nn \l__gradbars_colors_clist {\l_tmpa_int}}
          \gradbars@gradientfalse
        }
      \str_if_eq:eeTF {\gradbars@format}{percent}
        {\cs_set:Npx \gradbars@number
          {\fp_eval:n {100*\gradbars@value/\gradbars@max}}}
        {\cs_set:Npx \gradbars@number
          {\fp_eval:n {\gradbars@value}}}
    \fi
  }
\clist_new:N \l__gradbars_band_clist
\clist_new:N \l__gradbars_stack_clist
\clist_new:N \l__gradbars_stackcolors_clist
\fp_new:N \l__gradbars_sum_fp
\fp_new:N \l__gradbars_before_fp
\cs_new_protected:Npn \gradbarsValidateExtras
  {
    \clist_set:Nx \l__gradbars_band_clist {\gradbars@band}
    \clist_if_empty:NF \l__gradbars_band_clist
      {
        \tl_set:Nx \l_tmpa_tl {\gradbars@band}
        \regex_match:nVT {\A\s*,|,\s*,|,\s*\Z} \l_tmpa_tl
          {\gradbarsFail{Band~must~contain~two~endpoints}}
        \int_compare:nNnF {\clist_count:N \l__gradbars_band_clist} = {2}
          {\gradbarsFail{Band~must~contain~two~endpoints}}
        \clist_map_inline:Nn \l__gradbars_band_clist
          {\gradbarsCheckNumber{##1}{band~endpoint}}
        \gradbarsCheckNumber{\gradbars@bandopacity}{band~opacity}
        \ifgradbars@valid
          \cs_set:Npx \gradbars@bandlo {\clist_item:Nn \l__gradbars_band_clist {1}}
          \cs_set:Npx \gradbars@bandhi {\clist_item:Nn \l__gradbars_band_clist {2}}
          \fp_compare:nF {\gradbars@min <= \gradbars@bandlo < \gradbars@bandhi <= \gradbars@max}
            {\gradbarsFail{Band~must~be~increasing~and~within~range}}
          \fp_compare:nF {0 <= \gradbars@bandopacity <= 1}
            {\gradbarsFail{Band~opacity~must~be~between~zero~and~one}}
        \fi
      }
    \ifgradbars@stack
      \ifgradbars@valid
        \fp_compare:nNnF {\gradbars@min} = {0}
          {\gradbarsFail{Stacked~bars~require~min=0}}
      \fi
      \tl_if_empty:oF {\gradbars@thresholds}
        {\gradbarsFail{Stacked~bars~do~not~support~thresholds}}
      \ifgradbars@error \gradbarsFail{Stacked~bars~do~not~support~error~whiskers}\fi
      \clist_set:Nx \l__gradbars_stackcolors_clist {\gradbars@stackcolors}
      \clist_if_empty:NT \l__gradbars_stackcolors_clist
        {\gradbarsFail{Stack~colors~must~not~be~empty}}
    \fi
  }
\cs_new_protected:Npn \gradbarsDrawBand
  {
    \clist_if_empty:NF \l__gradbars_band_clist
      {
        \pgfmathsetlengthmacro\gradbars@bandxlo{\gradbarsPosition{\gradbars@bandlo}*(\gradbars@width)}
        \pgfmathsetlengthmacro\gradbars@bandxhi{\gradbarsPosition{\gradbars@bandhi}*(\gradbars@width)}
        \path[fill=\gradbars@bandcolor,fill~opacity=\gradbars@bandopacity,draw=none]
          (\gradbars@bandxlo,-2pt) rectangle ([yshift=2pt]\gradbars@bandxhi,\gradbars@height);
      }
  }
\cs_new_protected:Npn \gradbarsParseStack #1
  {
    \tl_set:Nx \l_tmpa_tl {#1}
    % Empty elements are invalid, not silently dropped by clist normalization.
    \regex_match:nVTF {\A\s*\Z|\A\s*,|,\s*,|,\s*\Z} \l_tmpa_tl
      {\gradbarsFail{Stack~requires~a~nonempty~list~of~numbers}} { }
    \clist_set:Nx \l__gradbars_stack_clist {#1}
    \fp_zero:N \l__gradbars_sum_fp
    \clist_map_inline:Nn \l__gradbars_stack_clist
      {
        \gradbarsCheckNumber{##1}{stack~segment}
        \ifgradbars@valid
          \fp_compare:nNnTF {##1} < {0}
            {\gradbarsFail{Stack~segments~must~be~nonnegative}}
            {\fp_add:Nn \l__gradbars_sum_fp {##1}}
        \fi
      }
    \cs_set:Npx \gradbars@total {\fp_to_decimal:N \l__gradbars_sum_fp}
  }
\cs_new_protected:Npn \gradbarsDrawStack
  {
    \fp_zero:N \l__gradbars_sum_fp
    \int_zero:N \l_tmpa_int
    \clist_map_inline:Nn \l__gradbars_stack_clist
      {
        \fp_set_eq:NN \l__gradbars_before_fp \l__gradbars_sum_fp
        \fp_add:Nn \l__gradbars_sum_fp {##1}
        \int_incr:N \l_tmpa_int
        \cs_set:Npx \gradbars@segmentcolor
          {\clist_item:Nn \l__gradbars_stackcolors_clist
            {1+\int_mod:nn {\l_tmpa_int-1}{\clist_count:N \l__gradbars_stackcolors_clist}}}
        \pgfmathsetlengthmacro\gradbars@segmentlo
          {\gradbarsPosition{\l__gradbars_before_fp}*(\gradbars@width)}
        \pgfmathsetlengthmacro\gradbars@segmenthi
          {\gradbarsPosition{\l__gradbars_sum_fp}*(\gradbars@width)}
        \ifdim\gradbars@segmenthi>\gradbars@segmentlo
          \path[fill=\gradbars@segmentcolor,draw=none]
            (\gradbars@segmentlo,0) rectangle (\gradbars@segmenthi,\gradbars@height);
        \fi
      }
  }
\ExplSyntaxOff

\def\gradbars@labelcontent{%
  \ifx\gradbars@text\@empty
    \ifgradbars@missing\gradbars@missingtext\else
      \begingroup
      \def\gradbars@temp{scientific}%
      \ifx\gradbars@numberformat\gradbars@temp
        \pgfmathprintnumber[sci,sci zerofill,precision=\gradbars@precision]{\gradbars@number}%
      \else
        \def\gradbars@temp{grouped}%
        \ifx\gradbars@numberformat\gradbars@temp
          \pgfmathprintnumber[fixed,fixed zerofill,precision=\gradbars@precision,1000 sep={\mathord{,}}]{\gradbars@number}%
        \else
          \pgfmathprintnumber[fixed,fixed zerofill,precision=\gradbars@precision,1000 sep={\,}]{\gradbars@number}%
        \fi
      \fi
      \def\gradbars@temp{percent}%
      \ifx\gradbars@format\gradbars@temp\%\else\gradbars@unit\fi
      \endgroup
    \fi
  \else\gradbars@text\fi
}

\def\gradbars@draw{%
  \pgfmathsetlengthmacro\gradbars@xzero{\gradbars@zero*(\gradbars@width)}%
  \pgfmathsetlengthmacro\gradbars@xend{\gradbars@end*(\gradbars@width)}%
  \pgfmathsetlengthmacro\gradbars@xstart{\gradbars@start*(\gradbars@width)}%
  \pgfmathsetlengthmacro\gradbars@xstop{\gradbars@stop*(\gradbars@width)}%
  \pgfmathsetlengthmacro\gradbars@radius{min(\gradbars@rounded,.5*(\gradbars@height),.5*(\gradbars@width))}%
  \path[rounded corners=\gradbars@radius,fill=\gradbars@track,draw=none]
    (0,0) rectangle (\gradbars@width,\gradbars@height);
  \gradbarsDrawBand
  \ifdim\gradbars@xstop>\gradbars@xstart
    \pgfmathsetlengthmacro\gradbars@fillradius{min(\gradbars@radius,.5*(\gradbars@xstop-\gradbars@xstart))}%
    \begin{scope}
      \clip[rounded corners=\gradbars@radius]
        (0,0) rectangle (\gradbars@width,\gradbars@height);
      \ifgradbars@stack
        \clip[rounded corners=\gradbars@fillradius]
          (\gradbars@xstart,0) rectangle (\gradbars@xstop,\gradbars@height);
        \gradbarsDrawStack
      \else\ifgradbars@gradient
        \path[rounded corners=\gradbars@fillradius,shade,
          left color=\gradbars@left,right color=\gradbars@right]
          (\gradbars@xstart,0) rectangle (\gradbars@xstop,\gradbars@height);
      \else
        \path[rounded corners=\gradbars@fillradius,fill=\gradbars@left,draw=none]
          (\gradbars@xstart,0) rectangle (\gradbars@xstop,\gradbars@height);
      \fi\fi
    \end{scope}
  \fi
  \ifdim\gradbars@xzero>0pt
    \draw[gradbarsInk!65,line width=.35pt]
      (\gradbars@xzero,0)--(\gradbars@xzero,\gradbars@height);
  \fi
  \ifx\gradbars@target\@empty\else
    \pgfmathsetlengthmacro\gradbars@xtarget{\gradbars@targetpos*(\gradbars@width)}%
    \draw[draw=\gradbars@targetcolor,line width=.6pt]
      ([yshift=-1pt]\gradbars@xtarget,0)--
      ([yshift=1pt]\gradbars@xtarget,\gradbars@height);
  \fi
  \ifgradbars@missing\else\ifgradbars@error
    \pgfmathsetlengthmacro\gradbars@xlo{\gradbars@errorlo*(\gradbars@width)}%
    \pgfmathsetlengthmacro\gradbars@xhi{\gradbars@errorhi*(\gradbars@width)}%
    \draw[draw=\gradbars@errorcolor,line width=.5pt]
      ([yshift=.5*\gradbars@height]\gradbars@xlo,0)--
      ([yshift=.5*\gradbars@height]\gradbars@xhi,0);
    \foreach \gradbars@cap in {\gradbars@xlo,\gradbars@xhi}{
      \draw[draw=\gradbars@errorcolor,line width=.5pt]
        ([yshift=.2*\gradbars@height]\gradbars@cap,0)--
        ([yshift=.8*\gradbars@height]\gradbars@cap,0);
    }
  \fi\fi
  \def\gradbars@temp{outside}%
  \ifx\gradbars@label\gradbars@temp
    \node[anchor=west,inner sep=0pt,outer sep=0pt,
      text=\gradbars@textcolor,font=\gradbars@font]
      at ([xshift=\gradbars@gap,yshift=.5*\gradbars@height]\gradbars@width,0)
      {\makebox[\gradbars@labelwidth][r]{\gradbars@labelcontent}};
  \else
    \def\gradbars@temp{inside}%
    \ifx\gradbars@label\gradbars@temp
      \node[anchor=east,inner sep=0pt,outer sep=0pt,
        text=\gradbars@textcolor,font=\gradbars@font]
        at ([xshift=-.35em,yshift=.5*\gradbars@height]\gradbars@width,0)
        {\gradbars@labelcontent};
    \else
      \def\gradbars@temp{end}%
      \ifx\gradbars@label\gradbars@temp
        \sbox\gradbars@labelbox{\pgfinterruptpicture
          \gradbars@font\gradbars@labelcontent\endpgfinterruptpicture}%
        \pgfmathsetlengthmacro\gradbars@labelx{max(.5*\wd\gradbars@labelbox,
          min(\gradbars@xend,\gradbars@width-.5*\wd\gradbars@labelbox))}%
        \node[anchor=south,inner sep=0pt,outer sep=0pt,text=\gradbars@textcolor]
          at ([yshift=2pt]\gradbars@labelx,\gradbars@height)
          {\usebox\gradbars@labelbox};
      \fi
    \fi
  \fi
}
\def\gradbars@render{%
  \gradbars@validtrue
  \gradbarsValidate
  \gradbarsValidateExtras
  \ifdim\gradbars@rounded<0pt
    \gradbars@validfalse
    \PackageError{gradbars}{Rounded radius must be nonnegative}{Use rounded=2pt.}%
  \fi
  \ifdim\gradbars@width>0pt\else
    \gradbars@validfalse
    \PackageError{gradbars}{Width must be positive}{Use a length such as 24mm.}%
  \fi
  \ifdim\gradbars@height>0pt\else
    \gradbars@validfalse
    \PackageError{gradbars}{Height must be positive}{Use a length such as 1.5ex.}%
  \fi
  \ifgradbars@valid
    \ifpgfpicture
      \begin{scope}\gradbars@draw\end{scope}%
    \else
      \tikz[baseline={([yshift=-.5ex]0,{.5*\gradbars@height})}]{\gradbars@draw}%
    \fi
  \fi
}
\NewDocumentCommand\gradbar{O{} m}{%
  \leavevmode\begingroup
    \pgfkeys{/gradbars,#1}%
    % Resolve font-relative dimensions in the surrounding text font.
    \ifpgfpicture
      \pgfinterruptpicture
      \font@name
      \edef\gradbars@resolved{%
        \noexpand\endpgfinterruptpicture
        \def\noexpand\gradbars@width{\the\dimexpr\gradbars@width\relax}%
        \def\noexpand\gradbars@height{\the\dimexpr\gradbars@height\relax}%
        \def\noexpand\gradbars@rounded{\the\dimexpr\gradbars@rounded\relax}%
        \def\noexpand\gradbars@gap{\the\dimexpr\gradbars@gap\relax}%
        \def\noexpand\gradbars@labelwidth{\the\dimexpr\gradbars@labelwidth\relax}%
      }%
      \gradbars@resolved
    \fi
    \def\gradbars@value{#2}%
    \gradbars@render
  \endgroup
}
\NewDocumentCommand\gradstack{O{} m}{%
  \leavevmode\begingroup
    \gradbars@validtrue
    \gradbarsParseStack{#2}%
    \ifgradbars@valid
      \gradbars@stacktrue
      \gradbar[#1]{\gradbars@total}%
    \fi
  \endgroup
}

\endinput
